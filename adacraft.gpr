project Adacraft is
   for Languages use ("Ada");
   for Source_Dirs use ("src/**", "tests", "generated");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("adacraft_server.adb", "test_handshake_exchange.adb", "test_status_exchange.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;
end Adacraft;
