project Differential is

   for Main use ("differential-main.adb");
   for Source_Dirs use (".", "src", "../src/protocol", "../src/ingress");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Languages use ("Ada");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;

end Differential;
