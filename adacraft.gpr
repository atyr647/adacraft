project Adacraft is
   for Languages use ("Ada");
   for Source_Dirs use ("src/**", "tests", "generated");
   for Object_Dir use "obj/adacraft";
   for Exec_Dir use "bin";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;
   for Main use ("adacraft_server.adb", "test_handshake_exchange.adb", "test_status_exchange.adb", "test_protocol_packet_encoder.adb", "test_bad_clients.adb", "test_login_server.adb", "test_frame_zero_length.adb");
end Adacraft;
