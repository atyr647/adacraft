project Adacraft is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "src/protocol", "src/kernel", "src/auth",
     "src/ingress", "src/network", "generated", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("adacraft_server.adb", "adacraft_tests.adb",
     "test_ingress_framing.adb", "test_protocol_varnum.adb",
     "test_protocol_state.adb", "test_protocol_packet_decoder.adb",
     "test_protocol_packet_encoder.adb", "test_corpus_loader.adb",
     "test_golden_corpus.adb", "test_protocol_login_encryption.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;

   package Builder is
      for Default_Switches ("Ada") use ("-g");
   end Builder;

   package Linker is
      for Default_Switches ("Ada") use ("-lcrypto");
   end Linker;
end Adacraft;
