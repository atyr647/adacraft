project Adacraft is
   for Languages use ("Ada");
   for Source_Dirs use ("src/**", "tests", "generated");
   for Object_Dir use "obj/adacraft";
   for Exec_Dir use "bin";
   for Main use ("adacraft_server.adb", "test_handshake_exchange.adb", "test_status_exchange.adb", "test_bad_clients.adb", "test_login_server.adb");
end Adacraft;
